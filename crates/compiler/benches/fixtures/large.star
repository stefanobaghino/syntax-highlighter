# sample starlark module
load("//tools:defs.bzl", "helper")

CONST = 42
NAMES = ["alpha", "beta", "gamma"]

def fib(n):
    if n < 2:
        return n
    else:
        return fib(n - 1) + fib(n - 2)

def classify(values):
    total = 0
    for x in values:
        if x > 0:
            total += x
        elif x < 0:
            total -= x
        else:
            total = total
    config = {
        "sum": total,
        "items": [1, 2, 3],
        "nested": {"a": 1, "b": 2},
    }
    return config

