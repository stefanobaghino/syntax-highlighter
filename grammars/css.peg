# TODO out of scope: `@document` / `@container` advanced preludes (treated
# as a generic token stream); full selector-list validation (we accept most
# practical shapes); full `url()` whitespace rules.

css = (statement)*^ {

    ignore = (comment / \s)*

    statement = at_rule
               / rule

    at_rule = at_name prelude (block / @punctuation ';') {
        at_name: atomic = @keyword ('@' ident_body+)

        prelude = prelude_token* {
            prelude_token = string_lit
                           / fn_call
                           / hex_color
                           / number_with_unit
                           / @keyword '!important'
                           / @type ident
                           / @punctuation '(' prelude @punctuation ')'
                           / @punctuation ','
                           / @punctuation ':'
                           / @operator '='
                           / @operator '+'
                           / @operator '-'
                           / @operator '*'
                           / @operator '/'
                           / @operator '>'
        }
    }

    rule = selector_list block {
        selector_list = selector (@punctuation ',' selector)* {
            selector = compound_selector combinator_and_next* {
                combinator_and_next = @operator '>' compound_selector
                                    / @operator '+' compound_selector
                                    / @operator '~' compound_selector
                                    / compound_selector

                compound_selector = selector_atom+ {
                    selector_atom: atomic = @property ('.' ident)
                                          / @constant ('#' ident)
                                          / @function ('::' ident pseudo_args?)
                                          / @function (':' ident pseudo_args?)
                                          / @punctuation '[' (.. ']') @punctuation ']'
                                          / @punctuation '&'
                                          / @punctuation '*'
                                          / @type ident
                    {
                        pseudo_args: atomic = '(' ..= ')'
                    }
                }
            }
        }
    }

    block = @punctuation '{' (block_item* @punctuation '}' ^^block_close ..= @punctuation '}') {
        block_item = at_rule
                    / declaration
                    / rule
                    / @punctuation ';'
        {
            declaration: partial = @property prop_ident @punctuation ':' value_list
                                   @keyword '!important'? (@punctuation ';' / &'}')
            {
                prop_ident: atomic = '--' ident_body+
                                    / '-'? ident

                value_list = value_term (@punctuation ',' value_term)*
            }
        }
    }

    value_term = value_factor+ {
        value_factor = string_lit
                      / fn_call
                      / hex_color
                      / number_with_unit
                      / url_unquoted
                      / @variable ident
                      / @operator '/'
                      / @operator '+'
                      / @operator '-'
                      / @operator '*'
        {
            url_unquoted = @function 'url' @punctuation '(' @string (.. ')') @punctuation ')'
        }
    }

    fn_call = @function ident @punctuation '(' fn_args? @punctuation ')' {
        fn_args = value_term (@punctuation ',' value_term)*
    }

    hex_color: atomic = @constant ('#' [\da-fA-F]+)

    number_with_unit = @number num_body {
        num_body: partial atomic = [+\-]? (num_float / \d+) num_unit? {
            num_float: atomic = \d* '.' \d+
                               / \d+ '.' \d*
            num_unit = '%'
                      / ident
        }
    }

    string_lit = @string (dq_string / sq_string) {
        dq_string: atomic = '"' (str_escape / !'"' !'\n' .)* '"'
        sq_string: atomic = "'" (str_escape / !"'" !'\n' .)* "'"
        str_escape: atomic = '\\' .
    }

    ident: atomic = (ident_start_char / css_escape) (ident_body_char / css_escape)* {
        ident_start_char = [A-Za-z_\-\u{80}-\u{10FFFF}]
    }
    ident_body_char = [A-Za-z\d_\-\u{80}-\u{10FFFF}]
    ident_body = ident_body_char / css_escape
    # Broad "any non-newline byte" escape: the precise hex-digit-count form
    # would force a partial-match call site that trips the lint.
    css_escape: atomic = '\\' !\R .

    comment: atomic = @comment ('/*' ..= '*/')
}
