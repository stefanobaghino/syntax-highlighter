json = value {

    ignore = \s*

    value = @string string
          / @number number
          / object
          / array
          / @constant 'true'
          / @constant 'false'
          / @constant 'null'
    {
        string: atomic = '"' string_char* '"' {
            string_char: atomic = '\\' ["\\/bfnrt]
                                / '\\' 'u' [\da-fA-F]{4}
                                / [^"\\]
        }

        number: atomic = '-'? int frac? exp? {
            int: atomic = '0' / [1-9] \d*
            frac: atomic = '.' \d+
            exp: atomic = [eE] [+\-]? \d+
        }

        object = @punctuation '{'
                 (pair (@punctuation ',' pair)*)?
                 @punctuation '}'

        array = @punctuation '['
                (value (@punctuation ',' value)*)?
                @punctuation ']'

        pair = @property string @punctuation ':' value
    }
}
